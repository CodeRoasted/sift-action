{
  "name": "sift-action",
  "version": "1.11.0",
  "private": true,
  "type": "module",
  "description": "Sift — structural diff of your CI logs, as a sticky PR comment + advisory gate.",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "tsc && node --test lib/tests/",
    "package": "node esbuild.config.mjs",
    "preflight": "tsc && node lib/tools/preflight.js"
  },
  "dependencies": {
    "@actions/artifact": "^6.2.1",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^9.1.1",
    "adm-zip": "^0.6.0",
    "js-yaml": "^4.3.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=24"
  }
}
